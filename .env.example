# Supabase — proiectul de dev pentru local/preview, cel de prod pentru production
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NU se prefixează cu NEXT_PUBLIC_. Se folosește doar în lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=
# doar pentru `pnpm db:types`
SUPABASE_PROJECT_ID=
# parola bazei, pentru `supabase link` și `supabase db push`
SUPABASE_DB_PASSWORD=

# Email (M3)
# Cu RESEND_API_KEY setat, emailurile pleacă prin Resend. Fără el, merg prin
# SMTP spre Mailpit-ul din `supabase start` și se văd la http://127.0.0.1:54324
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Andreea Gligor <contact@magia-uleiurilor.ro>"
EMAIL_REPLY_TO=
# folosite doar când RESEND_API_KEY lipsește
SMTP_HOST=127.0.0.1
SMTP_PORT=54325

# Meta (M6)
# Pixelul se încarcă în browser doar după acceptarea cookie-urilor.
NEXT_PUBLIC_META_PIXEL_ID=
# Aceleași valori, folosite server-side pentru Conversions API.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Doar în Preview: evenimentele apar în Test Events, nu în rapoarte.
META_TEST_EVENT_CODE=

# Google Analytics 4 — aceeaşi proprietate ca site-ul mare, acelaşi ID.
# Fără el, nu se încarcă nimic. Vezi PLAN-GA4.md.
NEXT_PUBLIC_GA4_ID=
# Doar pentru Measurement Protocol, de pe server. Se creează în fluxul de date,
# la „Measurement Protocol API secrets". NU se prefixează cu NEXT_PUBLIC_.
GA4_API_SECRET=

# Protejează /api/cron/* — apelat de GitHub Actions
CRON_SECRET=
# Câți destinatari maximum într-o rulare de cron. Ține trimiterile sub limita
# zilnică a planului gratuit Resend (100/zi).
CRON_BATCH_LIMIT=60

NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Sentry pornește doar dacă există DSN. Fără plugin de build, deci fără upload
# de source maps și fără token de organizație.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
